rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ay2608020@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().uid == userId
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().username is string && incoming().username.size() <= 50;
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().uid == userId &&
          // Cannot elevate self to admin role without being an admin
          (!incoming().diff(existing()).affectedKeys().hasAny(['role']) || existing().role == incoming().role)
        )
      );
      allow delete: if isAdmin();
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(postId)
        && incoming().authorId == request.auth.uid
        && incoming().content is string && incoming().content.size() <= 2000;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().authorId == request.auth.uid && incoming().authorId == request.auth.uid) ||
        // Allow updating social counters (likes, comments, reposts)
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'repostsCount', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (isAdmin() || existing().authorId == request.auth.uid);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && isValidId(commentId)
          && incoming().authorId == request.auth.uid
          && incoming().text is string && incoming().text.size() <= 1000;
        allow update: if isSignedIn() && (isAdmin() || existing().authorId == request.auth.uid);
        allow delete: if isSignedIn() && (isAdmin() || existing().authorId == request.auth.uid);
      }
    }

    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(likeId)
        && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
    }

    // Follows collection
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(followId)
        && incoming().followerId == request.auth.uid;
      allow delete: if isSignedIn() && (isAdmin() || existing().followerId == request.auth.uid);
    }

    // Blocks collection (Mandatory Feature)
    match /blocks/{blockId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(blockId)
        && incoming().blockerId == request.auth.uid;
      allow delete: if isSignedIn() && (isAdmin() || existing().blockerId == request.auth.uid);
    }

    // Follow Requests for Private Accounts
    match /follow_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(requestId)
        && incoming().fromUserId == request.auth.uid;
      allow delete: if isSignedIn() && (
        isAdmin() ||
        existing().fromUserId == request.auth.uid ||
        existing().toUserId == request.auth.uid
      );
    }

    // User Reports & Complaints
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(reportId)
        && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (
        isAdmin() || (request.auth.uid in existing().participants)
      );
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn()
        && isValidId(conversationId)
        && (request.auth.uid in incoming().participants);
      allow update: if isSignedIn() && (
        isAdmin() || (request.auth.uid in existing().participants)
      );
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isSignedIn()
          && isValidId(messageId)
          && incoming().senderId == request.auth.uid
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          && incoming().text is string && incoming().text.size() <= 2000;
        allow update: if isSignedIn() && (isAdmin() || existing().senderId == request.auth.uid);
        allow delete: if isSignedIn() && (isAdmin() || existing().senderId == request.auth.uid);
      }
    }

    // Time Capsules collection
    match /timeCapsules/{capsuleId} {
      allow get: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(capsuleId)
        && incoming().userId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 200;
      allow update: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
    }
  }
}
